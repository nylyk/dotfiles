[user]
  email = hi@nylyk.com
  name = nylyk
  signingkey = 399CC0B428B6334C
[commit]
  gpgsign = true
[init]
  defaultBranch = main
[pull]
  rebase = true
[rebase]
  autoStash = true
  updateRefs = true
[rerere]
  enabled = true
  autoUpdate = false
[branch "develop"]
  rebase = false
[branch "main"]
  rebase = false
[branch "master"]
  rebase = false
[push]
  autoSetupRemote = true
[fetch]
  prune = true
  pruneTags = true

[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  syntax-theme = gruvbox-dark
  plus-style = syntax "#2c3f2e"
  minus-style = syntax "#3f2c2c"
  plus-emph-style = syntax "#3d5740"
  minus-emph-style = syntax "#573d3d"
  line-numbers-plus-style = "#7fb069" "#2c3f2e"
  line-numbers-minus-style = "#c08484" "#3f2c2c"
  line-numbers-zero-style = "#8a7d73"
  navigate = true
  line-number = true
  side-by-side = true
[merge]
  conflictStyle = zdiff3
