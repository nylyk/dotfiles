  email = hi@nylyk.com
  name = nylyk
  signingkey = 399CC0B428B6334C
[commit]
  gpgsign = true
[init]
  defaultBranch = main
[pull]
  rebase = true

[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  syntax-theme = gruvbox-material
  plus-style = syntax "#0d2900"
  minus-style = syntax "#3e0c00"
  plus-emph-style = syntax "#024700"
  minus-emph-style = syntax "#72030a"
  line-numbers-plus-style = "#a9b665" "#0d2900"
  line-numbers-minus-style = "#ea6962" "#3e0c00"
  line-numbers-zero-style = "#928374"
  file-style = "#d8a657" bold
  file-decoration-style = "#d8a657" ul
  hunk-header-style = line-number syntax
  hunk-header-decoration-style = "#7c6f64" box
  navigate = true
  line-numbers = true
[merge]
  conflictStyle = zdiff3
